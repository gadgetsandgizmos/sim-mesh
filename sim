# The script's own directory stays the working one, so a SCRIPT path is the
# shell's.
cmd_run() {
    local py
    py=$(pick_python)
    PYTHONPATH="$ROOT/testbed${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m sim_mesh.runner "$@"
}

# run_script `run` ARGS…: a script, from this machine's shell. The front is
# started when none answers, and the pages the runner says are opened here,
# unless --no-browser; `--report` only writes a report, and needs neither.
run_script() {
    local args=() a report=
    NO_BROWSER=
    for a in "$@"; do
        case "$a" in
            --no-browser) NO_BROWSER=1 ;;
            --report) report=1; args+=("$a") ;;
            *) args+=("$a") ;;
        esac
    done
    if [ -z "$report" ]; then
        ensure_front
    fi
    local status
    set +e +o pipefail
    if want_container; then
        EXEC_ENV=(SIM_MESH_SAY_PAGES=1)
        in_front "${args[@]}" | relay_pages
        status=${PIPESTATUS[0]}
    else
        SIM_MESH_SAY_PAGES=1 cmd_run "${args[@]:1}" | relay_pages
        status=${PIPESTATUS[0]}
    fi
    set -e -o pipefail
    return "$status"
}

# ---- installing on Linux --------------------------------------------------------
# sim-mesh on a fresh Linux instead of in its image. `sim install` puts here
# what the image holds (Dockerfile), the system's packages through its
# package manager, with sudo, and fetches the prebuilt outputs. `--dev` adds
# what the development image holds (Dockerfile.dev): its packages; where the
# system's Node is older than the page's Vite and Quasar take, NodeSource's on
# Debian and Ubuntu (which ship 18) and Fedora's own later one on Fedora
# (which defaults to 22.21); Rust through rustup, in the user's home; and a
# Python environment beside this script, .venv, over the system's own
# packages, where a Node the system names by its major gets its plain name;
# then whatever is not prebuilt is built. A step whose result is already there
# is left out, so running it again costs nothing. apt (Debian, Ubuntu) and dnf
# (Fedora); elsewhere it says what to install. The lists are the Dockerfiles'
# (testbed/test_install.py keeps them so). Either form ends by leaving
# .native beside this script: `sim` runs on this machine from then on.

APT_PACKAGES=(ca-certificates python3 python3-aiohttp python3-yaml libstdc++6 procps)
APT_DEV_PACKAGES=(curl gnupg git python3-pytest python3-venv build-essential cmake
                  pkg-config ruby-dev ruby-bundler zlib1g-dev)
DNF_PACKAGES=(ca-certificates python3 python3-aiohttp python3-pyyaml libstdc++ procps-ng)
DNF_DEV_PACKAGES=(curl git python3-pytest gcc gcc-c++ make cmake pkgconf-pkg-config
                  ruby-devel rubygem-bundler zlib-devel)
NODE_MAJOR=22                       # NodeSource's, as the development image's
NODE_FEDORA=24                      # Fedora's own, beside its default

# Whether the node on the path is one the page builds with: 22.22 or later.
# Quasar's app-vite refuses anything older when it starts
# (lib/node-version-check.js), whatever its package.json says; Fedora 41 ships
# 22.21.
node_fits() {
    command -v node >/dev/null && node -e '
        const [a, b] = process.versions.node.split(".").map(Number);
        process.exit((a === 22 && b >= 22) || a > 22 ? 0 : 1)' 2>/dev/null
}

cmd_install() {
    local dry=0 dev=0 a
    for a in "$@"; do
        case "$a" in
            --dry-run) dry=1 ;;
            --dev) dev=1 ;;
            *) die "install: the options are --dev and --dry-run" ;;
        esac
    done
    [ "$(uname -s)" = Linux ] || die "install: Linux only; anywhere else sim-mesh runs in its image"
    local sudo=()
    [ "$(id -u)" = 0 ] || sudo=(sudo)
    step() { say "$*"; [ "$dry" = 1 ] || "$@"; }
    local manager apt=("${APT_PACKAGES[@]}") dnf=("${DNF_PACKAGES[@]}")
    [ "$dev" = 0 ] || { apt+=("${APT_DEV_PACKAGES[@]}"); dnf+=("${DNF_DEV_PACKAGES[@]}"); }
    if command -v apt-get >/dev/null; then manager=apt
    elif command -v dnf >/dev/null; then manager=dnf
    else die "install: neither apt-get nor dnf here; install by hand what the Dockerfiles hold"
    fi
    if [ "$manager" = apt ]; then
        step "${sudo[@]}" apt-get update
        step "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive \
            apt-get install -y --no-install-recommends "${apt[@]}"
    else
        step "${sudo[@]}" dnf install -y "${dnf[@]}"
    fi
    if [ "$dev" = 0 ]; then
        [ "$dry" = 1 ] && return 0
        ensure "${COMPONENTS[@]}"
        : > "$ROOT/.native"
        say "installed: start it with $0"
        return 0
    fi
    # The environment first: it is also where a Node the system names by its
    # major is given its plain name.
    if [ ! -x "$ROOT/.venv/bin/python3" ]; then
        step python3 -m venv --system-site-packages "$ROOT/.venv"
    fi
    PATH="$ROOT/.venv/bin:$PATH"
    if ! node_fits; then
        if [ "$manager" = apt ]; then
            say "Node $NODE_MAJOR from NodeSource: the system's is older than the page takes"
            if [ "$dry" = 0 ]; then
                "${sudo[@]}" mkdir -p /etc/apt/keyrings
                curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
                    | "${sudo[@]}" gpg --batch --yes --dearmor -o /etc/apt/keyrings/nodesource.gpg
                echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" \
                    | "${sudo[@]}" tee /etc/apt/sources.list.d/nodesource.list >/dev/null
            fi
            step "${sudo[@]}" apt-get update
            step "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y nodejs
        else
            # Fedora ships a Node newer than its default under the major's
            # name (nodejs24: node-24, npm-24), beside the default, which
            # stays as it is: the plain names go into the environment.
            say "Node $NODE_FEDORA, Fedora's own: its default is older than the page takes"
            step "${sudo[@]}" dnf install -y "nodejs$NODE_FEDORA" "nodejs$NODE_FEDORA-npm"
            local tool
            for tool in node npm npx; do
                step ln -sf "/usr/bin/$tool-$NODE_FEDORA" "$ROOT/.venv/bin/$tool"
            done
        fi
    fi
    [ "$dry" = 1 ] || node_fits || die "install: node $(node --version 2>/dev/null) is still older than the page takes"
    if ! command -v cargo >/dev/null && [ -x "$HOME/.cargo/bin/cargo" ]; then PATH="$HOME/.cargo/bin:$PATH"; fi
    if ! command -v cargo >/dev/null; then
        say "Rust through rustup, into $HOME/.cargo"
        if [ "$dry" = 0 ]; then
            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
            PATH="$HOME/.cargo/bin:$PATH"
        fi
    fi
    if command -v rustup >/dev/null; then step rustup target add wasm32-unknown-unknown; fi
    [ "$dry" = 1 ] && return 0
    ensure "${COMPONENTS[@]}"
    : > "$ROOT/.native"
    say "installed: start it with $0"
}

# test: run tests.yaml tests in sim container, in order to use current Dockerfile, same mounts and options
cmd_test() {
    python3 - "$ROOT" "$@" <<'PY'
import subprocess, sys, yaml
root, ids = sys.argv[1], sys.argv[2:]
tests = {t["id"]: t for t in yaml.safe_load(open(f"{root}/tests.yaml"))["tests"]}
unknown = [i for i in ids if i not in tests]
if unknown:
    sys.exit(f"sim: test: no test {', '.join(unknown)} (tests.yaml has {', '.join(tests)})")
failed = []
for i in ids or [i for i, t in tests.items() if t["tier"] == "smoke"]:
    print(f"sim: test: {i}", file=sys.stderr, flush=True)
    if subprocess.run(["bash", "-c", tests[i]["run"]], cwd=root).returncode:
        failed.append(i)
if failed:
    sys.exit(f"sim: test: failed: {' '.join(failed)}")
PY
}

# ---- dispatch -------------------------------------------------------------------

EXEC_ENV=()
verb=${1:-}
case "$verb" in
    -h|--help|help) usage; exit 0 ;;
    install) shift; cmd_install "$@"; exit $? ;;
    ""|front|dev|build|-*|firmware|index|geodata|nodeset|source|new|stop|pause|resume|list|plan|run|test) ;;
    *) die "no verb '$verb' (sim help lists them)" ;;
esac

if [ -n "${SIM_MESH_FRONT:-}" ]; then
    case "$verb" in
        ""|front|dev|-*) die "SIM_MESH_FRONT says the front runs at $SIM_MESH_FRONT: start it there, not here" ;;
    esac
fi

if [ -z "${SIM_MESH_IN_CONTAINER:-}" ]; then
    case "$verb" in
        run) run_script "$@"; exit $? ;;
        new) ensure_front ;;
    esac
    # Publishing uploads with the GitHub token of the gh logged in here,
    # unless one is set already.
    if [ "${2:-}" = publish ] && [ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null; then
        GH_TOKEN=$(gh auth token 2>/dev/null) || GH_TOKEN=
        export GH_TOKEN
    fi
    [ -z "${GITHUB_TOKEN:-}" ] || [ -n "${GH_TOKEN:-}" ] || export GH_TOKEN=$GITHUB_TOKEN
fi

# test runs don't need GH tokens, and any test code could read and leak one
[ "$verb" != test ] || unset GH_TOKEN GITHUB_TOKEN

if want_container; then
    case "$verb" in
        firmware|index|geodata|nodeset|source|test) in_container tools "$@" ;;
        new|stop|pause|resume|list|plan) in_front "$@" ;;
        front) shift; in_container front "$@" ;;
        dev) in_container dev "$@" ;;
        build) in_container build "$@" ;;
        *) in_container front "$@" ;;
    esac
    exit $?
fi

case "$verb" in
    firmware) shift; [ $# -gt 0 ] || die "firmware: add, list, delete, prebuilt, resolve or publish"; cmd_firmware "$@" ;;
    index|geodata|nodeset)
        [ $# -gt 1 ] || die "$verb: $([ "$verb" = index ] && echo "list, add or delete" \
                                     || echo "list, offered, add, delete or publish")"
        cmd_indexes "$@" ;;
    source) shift; [ $# -gt 0 ] || die "source: check, list or outline"; cmd_source "$@" ;;
    new|stop|pause|resume|list|plan) cmd_sims "$@" ;;
    run) shift; cmd_run "$@" ;;
    front) shift; cmd_front "$@" ;;
    dev) shift; cmd_dev "$@" ;;
    build) shift; cmd_build "$@" ;;
    test) shift; cmd_test "$@" ;;
    *) cmd_front "$@" ;;
esac
